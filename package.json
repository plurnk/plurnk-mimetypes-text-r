{
    "name": "@plurnk/plurnk-mimetypes-text-r",
    "version": "1.1.0",
    "description": "text/x-r mimetype handler for plurnk-service. Tier 2: tree-sitter-r grammar built to WASM and shipped pre-built. Covers R 4.1+ including native pipes, lambdas, S3/S4 object systems, and tidyverse-style code.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "plurnk": {
        "kind": "mimetype",
        "handlers": [
            {
                "name": "text/x-r",
                "glyph": "📊",
                "extensions": [
                    ".R",
                    ".r"
                ]
            }
        ]
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./r.wasm": "./r.wasm"
    },
    "files": [
        "dist/**/*",
        "r.wasm",
        ".r-grammar-pin",
        "README.md"
    ],
    "scripts": {
        "build:wasm": "node scripts/build-wasm.mjs",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "test:lint": "tsc --noEmit",
        "test:unit": "node --test src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "prepare": "npm run build && (git config core.hooksPath .githooks || true)",
        "verify:wasm": "node scripts/verify-wasm.mjs",
        "deps:fresh": "npm outdated",
        "prepublishOnly": "npm run deps:fresh && npm audit --audit-level=moderate && npm test"
    },
    "dependencies": {
        "web-tree-sitter": "^0.26.9"
    },
    "devDependencies": {
        "@plurnk/plurnk-mimetypes": "1.1.0",
        "@types/node": "^26.0.0",
        "tree-sitter-cli": "^0.26.9",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "1.1.0"
    }
}
